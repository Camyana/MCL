# Packaging configuration for the BigWigs/CurseForge packager.
#
# Without a changelog of our own the packager builds one from the git
# history, which is where the "lightweight tag / Author / Date / commit"
# preamble in the What's New panel comes from.  Pointing it at
# CHANGELOG.md ships our own release notes instead.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

# MCL ships two TOC files - MCL.toc for retail and MCL_Forever.toc for
# World of Warcraft: Forever.  With more than one, the packager cannot
# work out the addon's folder name and aborts the build, so name it.
package-as: MCL
